# Copy to .env.local to turn on SSO mode. With none of these set, the app runs in
# dev mode with the "View as" switcher.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Set to 1 on a throwaway hosted demo to show the "Reset demo data" button.
# Leave unset everywhere else.
DEMO_MODE=
